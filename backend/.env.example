# Uygulama
MEDSPACED_ENVIRONMENT=development
MEDSPACED_SECRET_KEY=change-me-to-a-long-random-string
MEDSPACED_API_PREFIX=/api/v1
MEDSPACED_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Veritabanı (üretimde PostgreSQL)
MEDSPACED_DATABASE_URL=sqlite:///./var/medspaced.db
# MEDSPACED_DATABASE_URL=postgresql+psycopg://medspaced:medspaced@localhost:5432/medspaced
MEDSPACED_DB_POOL_SIZE=5
MEDSPACED_DB_MAX_OVERFLOW=10
MEDSPACED_DB_POOL_TIMEOUT_SECONDS=30
MEDSPACED_DB_POOL_RECYCLE_SECONDS=1800

# Dosya depolama
MEDSPACED_STORAGE_DIR=./var/storage
MEDSPACED_MAX_UPLOAD_MB=50

# LLM: fake | openai | anthropic | ollama | vllm
MEDSPACED_LLM_PROVIDER=fake
MEDSPACED_LLM_BASE_URL=https://api.openai.com/v1
MEDSPACED_LLM_API_KEY=
MEDSPACED_LLM_MODEL=gpt-4o-mini
MEDSPACED_LLM_TEMPERATURE=0.2
MEDSPACED_LLM_MAX_RETRIES=2
MEDSPACED_LLM_TIMEOUT_SECONDS=90

# Öğrenme ayarları
MEDSPACED_SRS_ALGORITHM=fsrs
MEDSPACED_MASTERY_THRESHOLD=70
MEDSPACED_DAILY_NEW_CARD_LIMIT=20
MEDSPACED_MAX_CHUNKS_PER_GENERATION=40
MEDSPACED_FSRS_OPTIMIZER_ENABLED=true
MEDSPACED_FSRS_OPTIMIZER_MIN_REVIEWS=512

# Vaka vinyeti değerlendirmesi
MEDSPACED_VIGNETTE_LLM_EVAL=true
MEDSPACED_VIGNETTE_PASS_SCORE=0.65

# Gözlemlenebilirlik
MEDSPACED_LOG_LEVEL=INFO
# text | json
MEDSPACED_LOG_FORMAT=text

# Hız sınırlama: memory | redis
MEDSPACED_RATE_LIMIT_ENABLED=true
MEDSPACED_RATE_LIMIT_BACKEND=memory
MEDSPACED_REDIS_URL=redis://localhost:6379/0
MEDSPACED_RATE_LIMIT_PER_MINUTE=120
MEDSPACED_AUTH_RATE_LIMIT_PER_MINUTE=10
MEDSPACED_TRUST_PROXY_HEADERS=false
MEDSPACED_TRUSTED_PROXIES=

# Uzun görev kuyruğu: inline | celery
MEDSPACED_JOB_QUEUE_BACKEND=inline
# Docker entrypoint migration kontrolü
MEDSPACED_RUN_MIGRATIONS=true

# Sentry uyumlu hata toplama
MEDSPACED_SENTRY_DSN=
MEDSPACED_SENTRY_TRACES_SAMPLE_RATE=0

# OpenTelemetry OTLP/HTTP izleme
MEDSPACED_OTEL_ENABLED=false
MEDSPACED_OTEL_EXPORTER_OTLP_ENDPOINT=
MEDSPACED_OTEL_SERVICE_NAME=medspaced-api

# Metrikler (/metrics, Prometheus metin formatı)
MEDSPACED_METRICS_ENABLED=true
MEDSPACED_METRICS_TOKEN=

# PostgreSQL yedekleme (pg_dump/pg_restore yolu; PATH yeterliyse boş bırakın)
MEDSPACED_PG_BIN=

# Token süreleri
MEDSPACED_ACCESS_TOKEN_MINUTES=60
MEDSPACED_REFRESH_TOKEN_DAYS=14
